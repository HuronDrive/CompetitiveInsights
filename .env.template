# Competitive Insights - API Configuration
# Copy this file to .env and fill in your API keys

# SimilarWeb API Key
# Get yours at: https://account.similarweb.com/api-management
# Required plan: API-only, Business, or Enterprise
SIMILARWEB_API_KEY=your_similarweb_api_key_here

# Ahrefs API Key (API v3)
# Get yours at: https://ahrefs.com/api
# Note: Use API v3 keys, not MCP keys
AHREFS_API_KEY=your_ahrefs_api_key_here

# SEMRush API Key
# Get yours at: https://www.semrush.com/api-analytics/
# Required plan: SEO Business (Standard API) or Trends Basic/Premium
SEMRUSH_API_KEY=your_semrush_api_key_here

# Development Mode
# Set to 'false' to use real MCP servers, 'true' for mock data
USE_MOCK_DATA=true

# Optional: Cache and Rate Limiting (SEMRush)
API_CACHE_TTL_SECONDS=300
API_RATE_LIMIT_PER_SECOND=10
